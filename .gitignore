# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# archives
*.zip
*.tar.gz
*.sql

# carpeta de origen de materiales: el PDF publicado vive en public/materials/
/LIBRO

# carpetas de trabajo local: los archivos publicados viven en public/
