/Nueva landing 10 jun 2026
/scratch

# env files (can opt-in for committing if needed)
.env*
!.env.example


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.env*.local

# carpeta de origen de imágenes del blog: las publicadas viven en public/images/blog/
/Imagen blog
